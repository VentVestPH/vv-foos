# Node
node_modules/
dist/
build/
*.log
npm-debug.log*

# Environment. Real keys never enter git.
.env
.env.*
!.env.example
# app/.env.development is the LOCAL Supabase target and is meant to be shared:
# it holds only the standard Supabase demo keys, which are byte-identical on
# every machine and worthless off 127.0.0.1. Without this negation the '.env.*'
# rule above silently swallows it, and a fresh clone has no dev configuration
# at all — `npm run dev` would fail at boot in lib/supabase.ts.
!.env.development

# Supabase local dev temp
supabase/.temp/
supabase/.branches/
supabase/functions/**/node_modules/

# OS
.DS_Store

# Playwright run artifacts (traces, screenshots, error contexts)
tests/test-results/
test-results/
tests/playwright-report/

# Zoho export files: real candidate and customer PII. Never committed.
migration/zoho-exports/
migration/out/

# Agent scratch space; never committed.
.scratch-audit/
tests/.scratch-audit/

# knip cache
.knip/

.gate/
.verify

# Audit output: screenshots render real candidate names. Never committed.
# Covers every dated run, audit/2026-09-08/ and every one after it. The old narrow
# rule named audit/corpus/ only, so a dated sibling was not ignored at all.
audit/*/

# armed goal + reminder throttle stamp, per-session state
.claude/goal-armed.md
.claude/.goal-reminder-stamp
