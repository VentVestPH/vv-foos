{
  "name": "ventvest-foos-redesign-2",
  "version": "0.1.0",
  "private": true,
  "description": "VentVest Front Office OS - Taleo-exact UI redesign frontend (interchangeable with /foos, same Supabase backend). Dev server on port 5175. See VVPH_VV-FOOS_Prompt_Taleo-Exact-UI-Redesign_2026-07-25_v1.0_Draft.md.",
  "workspaces": [
    "app",
    "tests"
  ],
  "scripts": {
    "db:push": "node scripts/confirm-production-push.mjs && supabase db push",
    "db:reset": "supabase db reset && node scripts/post-reset.mjs",
    "db:validate": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f supabase/tests/validate.sql",
    "test": "npm run test --workspace=tests",
    "test:e2e": "npm run e2e --workspace=tests",
    "db:seed:personas": "node scripts/post-reset.mjs --personas-only",
    "db:add-staff": "node scripts/add-local-staff.mjs",
    "db:sync-test-accounts": "node scripts/sync-test-accounts.mjs",
    "check:env": "node scripts/check-env-target.mjs",
    "check:env:production": "node scripts/check-env-target.mjs --production",
    "check:licences": "node scripts/check-licences.mjs --list",
    "check:dead": "knip",
    "gate": "bash scripts/gate.sh",
    "deploy:pages": "npm run build --workspace=app && npx wrangler pages deploy app/dist --project-name \"${CF_PAGES_PROJECT:-foos}\" --commit-dirty=true"
  },
  "devDependencies": {
    "knip": "^6.34.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0"
  }
}
