# Environment configuration for the FOOS frontend.
#
# Vite loads env files in increasing priority:
#   1. .env                    all modes
#   2. .env.local              all modes, gitignored
#   3. .env.[mode]             mode-specific   <- .env.development wins in dev
#   4. .env.[mode].local       mode-specific, gitignored
#
# DEVELOPMENT  -> app/.env.development (committed, points at local Supabase).
#                 Nothing to fill in. Run `supabase start` and `npm run dev`.
#
# PRODUCTION   -> do NOT commit real keys. Set these two variables in the
#                 hosting platform instead (Vercel: Project Settings >
#                 Environment Variables; Fly: `fly secrets set`). Platform
#                 variables override every file above.
#
# The anon key is safe in a browser bundle by design: row-level security in
# Postgres is the boundary, not the key. It still should not be committed,
# because it identifies the live project.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
