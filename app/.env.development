# LOCAL DEVELOPMENT TARGET. Safe to commit.
#
# Vite loads .env.development at higher priority than .env when running in dev
# mode, so `npm run dev` now points at the LOCAL Supabase stack rather than the
# live project. That matters: the hosted database holds 76 real people, real
# recruiter assessment notes, and attachment metadata referencing identity
# documents. Development should not write to it by accident.
#
# These keys are NOT secrets. They are the standard Supabase local demo keys,
# byte-identical on every `supabase start` on every machine, signed with the
# published default JWT secret. They grant nothing outside 127.0.0.1.
#
# Start the stack first:  supabase start
# Studio:                 http://127.0.0.1:55323
# Mail catcher:           http://127.0.0.1:55324
# Postgres:               postgresql://postgres:postgres@127.0.0.1:55322/postgres
#
# Seed the four personas with a password of your choosing (no default by
# design, QA-003), then sign in as any of them:
#   demo-admin@ventvest.test (admin) · rita.demo@ventvest.com (recruiter)
#   sam.demo@ventvest.com (sourcer)  · ben.demo@ventvest.com (bd)
# See docs/environments/ for the exact psql command.

VITE_SUPABASE_URL=http://127.0.0.1:55321
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
