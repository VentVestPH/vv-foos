# Edge Function secrets for the LOCAL stack only. Copy to
# supabase/functions/.env (gitignored) and restart with `supabase stop && supabase start`.
#
# Both of the endpoints below now fail CLOSED: with no secret set they return
# 503 and refuse every request, instead of silently accepting unauthenticated
# writes made with the service-role key.
#
# In the hosted project these are set as function secrets
# (`supabase secrets set NAME=value`), never committed.

INTAKE_EMAIL_PARSER_SECRET=local-dev-only-intake-secret
GOOGLE_SYNC_SECRET=local-dev-only-sync-secret
