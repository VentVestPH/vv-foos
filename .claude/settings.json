{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r \".tool_response.filePath // .tool_input.file_path // empty\" | { read -r f; [ -n \"$f\" ] && node \"${CLAUDE_PROJECT_DIR:-.}/scripts/check-comments.mjs\" \"$f\"; } 2>/dev/null || true",
            "timeout": 15,
            "statusMessage": "Checking comments..."
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/goal-reminder.sh\" 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "Goal reminder..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "FOOS_REMINDER_SECONDS=0 bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/goal-reminder.sh\" 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "Goal reminder..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "zsh \"${CLAUDE_PROJECT_DIR:-.}/scripts/ci-status.sh\" 2>/dev/null || true",
            "timeout": 20,
            "statusMessage": "Checking CI..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "FOOS_REMINDER_SECONDS=0 bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/goal-reminder.sh\" 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "Goal reminder..."
          }
        ]
      }
    ]
  }
}
