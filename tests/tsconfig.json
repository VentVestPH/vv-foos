{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "vite/client"
    ],
    "noEmit": true,
    "exactOptionalPropertyTypes": true
  },
  "include": [
    "**/*.ts"
  ]
}
