# Copy to .env (gitignored). Use the FOOS local URL and the anon key from npm run local:status.
FOOS_SUPABASE_URL=http://127.0.0.1:56321
FOOS_SUPABASE_ANON_KEY=your-anon-key

# Test-persona sign-in password. Choose a value, seed it with
# tests/fixtures/personas.sql, then put the same value here. There is no default
# in code on purpose: the previous hardcoded literal was a working credential
# against the live project and should never have been in git (QA-003).
FOOS_QA_TEST_PASSWORD=VentVest-Sandbox-2026

# Only needed for tests/e2e (Playwright) if the dev server runs somewhere
# other than localhost:5176.
# FOOS_BASE_URL=http://localhost:5176

# Must match INTAKE_EMAIL_PARSER_SECRET in supabase/functions/.env. The parser
# fails closed (503) when no secret is configured, so this is required.
FOOS_INTAKE_PARSER_SECRET=local-dev-only-intake-secret
