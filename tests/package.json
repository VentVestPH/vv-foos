{
  "name": "foos-qa",
  "version": "0.1.0",
  "private": true,
  "description": "FOOS test suite: unit and integration tests (Vitest), browser tests (Playwright) and the audit harness. tests/README.md is the map.",
  "type": "module",
  "scripts": {
    "test": "vitest run --workspace config/vitest.workspace.ts --no-file-parallelism",
    "test:unit": "vitest run --workspace config/vitest.workspace.ts --project unit",
    "test:integration": "vitest run --workspace config/vitest.workspace.ts --project integration --no-file-parallelism",
    "test:watch": "vitest --workspace config/vitest.workspace.ts --project unit",
    "e2e": "playwright test -c config/playwright.config.ts",
    "audit": "playwright test -c config/playwright.audit.config.ts",
    "e2e:install": "playwright install --with-deps chromium",
    "typecheck": "tsc --noEmit",
    "cwv": "node perf/measure-cwv.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@supabase/supabase-js": "^2.45.0",
    "@types/node": "^22.20.1",
    "axe-core": "^4.13.0",
    "dotenv": "^16.4.5",
    "vitest": "^2.1.1",
    "typescript": "^5.5.4"
  }
}
